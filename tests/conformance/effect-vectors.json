      "canonical": "{\"action\":\"data.write\",\"op\":{\"\\u001f\":4,\"a\\\"b\":1,\"c\\\\d\":2,\"e\\u0000f\":3},\"resource\":\"host:prod/database:analytics\",\"service\":\"datastore\",\"v\":1}",
      "effect": "sha256:0c47859b64fb1b1cfa3f8f9b1e42374f5b0d4f0b4a86d5ad6e56fb095fc2d0cd"
    },
    {
