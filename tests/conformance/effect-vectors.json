{
  "v": 1,
  "description": "Test vectors for the effect of protocol 17.3. A vector of the group V01 gives the canonical text and the effect of its input. A vector of the group V02 has an input that a PEP and a PDP refuse with the error invalid_op.",
  "vectors": [
    {
      "id": "member-order-sorted",
      "group": "V01",
      "title": "The members of op are in the sorted order.",
      "input": {
        "service": "datastore",
        "action": "data.write",
        "resource": "host:prod/database:analytics",
        "op": {"a":2,"b":1}
      },
      "canonical": "{\"action\":\"data.write\",\"op\":{\"a\":2,\"b\":1},\"resource\":\"host:prod/database:analytics\",\"service\":\"datastore\",\"v\":1}",
      "effect": "sha256:312d70a4c33d9c67e145e81dcfde38599f3f01f95bc763f10916a12f410b7015"
    },
    {
      "id": "member-order-reversed",
      "group": "V01",
      "title": "The members of op are in the reverse order. The text and the effect are the same as for member-order-sorted.",
      "input": {
        "service": "datastore",
        "action": "data.write",
        "resource": "host:prod/database:analytics",
        "op": {"b":1,"a":2}
      },
      "canonical": "{\"action\":\"data.write\",\"op\":{\"a\":2,\"b\":1},\"resource\":\"host:prod/database:analytics\",\"service\":\"datastore\",\"v\":1}",
      "effect": "sha256:312d70a4c33d9c67e145e81dcfde38599f3f01f95bc763f10916a12f410b7015"
    },
    {
