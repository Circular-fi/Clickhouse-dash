        "service": "datastore",
        "action": "data.write",
        "resource": "host:prod/database:analytics",
        "op": {"tool":"run_write_query","target":{"host":"prod","database":"analytics"},"options":{"timeout":30,"dry_run":false,"tags":["x",{"b":1,"a":2}],"note":null}}
      },
      "canonical": "{\"action\":\"data.write\",\"op\":{\"options\":{\"dry_run\":false,\"note\":null,\"tags\":[\"x\",{\"a\":2,\"b\":1}],\"timeout\":30},\"target\":{\"database\":\"analytics\",\"host\":\"prod\"},\"tool\":\"run_write_query\"},\"resource\":\"host:prod/database:analytics\",\"service\":\"datastore\",\"v\":1}",
      "effect": "sha256:b748ba680637d44675ca33ecc3c63b9d2528c0b8444f54b4a907b449e8b91428"
    },
    {
      "id": "literals",
      "group": "V01",
      "title": "The literals true, false and null keep their lower-case form.",
      "input": {
        "service": "datastore",
        "action": "data.write",
        "resource": "host:prod/database:analytics",
        "op": {"t":true,"f":false,"n":null}
      },
      "canonical": "{\"action\":\"data.write\",\"op\":{\"f\":false,\"n\":null,\"t\":true},\"resource\":\"host:prod/database:analytics\",\"service\":\"datastore\",\"v\":1}",
      "effect": "sha256:bab3e2d0c22236ffa927a9528f31474c74f12808a8aa809cc02628735672937c"
    },
    {
      "id": "array-order-kept",
      "group": "V01",
      "title": "An array keeps the order of its items. Empty arrays and objects are items.",
      "input": {
        "service": "datastore",
        "action": "data.write",
        "resource": "host:prod/database:analytics",
        "op": {"a":[3,1,2,[],{}]}
      },
      "canonical": "{\"action\":\"data.write\",\"op\":{\"a\":[3,1,2,[],{}]},\"resource\":\"host:prod/database:analytics\",\"service\":\"datastore\",\"v\":1}",
      "effect": "sha256:028f26de4c19c2bbe5c1070c5c7d0419f8cc78e2a0bab342ccc23ebade9d5d49"
    },
    {
      "id": "utf16-key-order",
      "group": "V01",
      "title": "Keys sort by UTF-16 code unit. The key U+10000 and the key U+1F600 come before U+E000, and U+FFFD comes last.",
      "input": {
        "service": "datastore",
        "action": "data.write",
        "resource": "host:prod/database:analytics",
        "op": {"\ufffd":5,"\ue000":4,"\ud83d\ude00":3,"\ud800\udc00":2,"a":1}
      },
      "canonical": "{\"action\":\"data.write\",\"op\":{\"a\":1,\"𐀀\":2,\"😀\":3,\"\ue000\":4,\"\ufffd\":5},\"resource\":\"host:prod/database:analytics\",\"service\":\"datastore\",\"v\":1}",
      "effect": "sha256:c7e3396d787d7739c9407356fabc7340b2609922437317160911eb66dc85c9fc"
    },
    {
      "id": "string-escapes",
      "group": "V01",
      "title": "A value has the short escapes, the long escapes in lower case, and characters that stay unescaped. The slash is not escaped.",
      "input": {
        "service": "datastore",
        "action": "data.write",
        "resource": "host:prod/database:analytics",
        "op": {"s":"q\" b\\ s\/ \b \t \n \f \r \u0000 \u001f \u007f \u0080 \u2028 \u00e9 \u0041 \ud83d\ude00"}
      },
      "canonical": "{\"action\":\"data.write\",\"op\":{\"s\":\"q\\\" b\\\\ s/ \\b \\t \\n \\f \\r \\u0000 \\u001f \u007f \u0080 \u2028 é A 😀\"},\"resource\":\"host:prod/database:analytics\",\"service\":\"datastore\",\"v\":1}",
      "effect": "sha256:26eaea96d797ae4038e44c00af8e3c6a31249e69ad01c3fc95b78b0355a1ef2c"
    },
    {
