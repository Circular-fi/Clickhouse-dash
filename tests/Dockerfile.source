ARG CHDASH_SEMVER=source
ARG CHDASH_GIT_SHA=local
ARG CHDASH_BUILD_TIME=tests
ARG SOURCE_CMAKE_BUILD_TYPE=Release

FROM alpine:3.20 AS toolchain
WORKDIR /work

RUN apk add --no-cache \
    ca-certificates \
    build-base \
    libstdc++-dev \
    cmake \
    ninja \
    git \
    lld

FROM toolchain AS deps
COPY src/CMakeLists.txt /work/src/
COPY src/EmbedStatic.cmake /work/src/

RUN cmake -S /work/src -B /work/build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCHDASH_BUILD_APP=OFF \
      -DCHDASH_EMBED_STATIC=OFF \
 && cmake --build /work/build --target clickhouse-cpp-lib

FROM toolchain AS builder
ARG CHDASH_SEMVER
ARG CHDASH_GIT_SHA
ARG CHDASH_BUILD_TIME
ARG SOURCE_CMAKE_BUILD_TYPE
COPY --from=deps /work/build /work/build
COPY src/CMakeLists.txt /work/src/
COPY src/EmbedStatic.cmake /work/src/
COPY src/*.cpp /work/src/
COPY src/*.hpp /work/src/

RUN cmake -S /work/src -B /work/build -G Ninja \
      -DCMAKE_BUILD_TYPE=${SOURCE_CMAKE_BUILD_TYPE} \
      -DCHDASH_BUILD_APP=ON \
      -DCHDASH_EMBED_STATIC=OFF \
      -DCHDASH_SEMVER_VALUE="${CHDASH_SEMVER}" \
      -DCHDASH_GIT_SHA_VALUE="${CHDASH_GIT_SHA}" \
      -DCHDASH_BUILD_TIME_VALUE="${CHDASH_BUILD_TIME}" \
      -DCMAKE_EXE_LINKER_FLAGS="-fuse-ld=lld" \
 && cmake --build /work/build --target chdash -j$(nproc) \
 && cp /work/build/chdash /work/chdash

# The page stylesheets are build outputs (tools/build_page_css.py): generate
# them from src/static/css/ and ship src/static without the sources.
FROM alpine:3.20 AS static
RUN apk add --no-cache python3
WORKDIR /work
COPY tools/build_page_css.py tools/css_tree.py tools/icons.py tools/page_shells.py /work/tools/
COPY src/shell /work/src/shell
COPY src/static /work/src/static
RUN rm -f /work/src/static/style.*.css \
 && python3 /work/tools/build_page_css.py --out /work/src/static \
 && rm -rf /work/src/static/css

# The WebAssembly kernels (docs/wasm.md) are committed in src/static/wasm. This stage rebuilds them from src/wasm with the
# pinned toolchain (alpine:3.20, clang 18, lld) and fails the image when the rebuild differs from the committed files.
FROM alpine:3.20 AS wasm
RUN apk add --no-cache python3 clang18 lld
WORKDIR /work
COPY tools/build_wasm.py /work/tools/
COPY src/wasm /work/src/wasm
COPY src/static/wasm /work/src/static/wasm
RUN python3 /work/tools/build_wasm.py --check

FROM alpine:3.20 AS runtime
RUN apk add --no-cache ca-certificates libstdc++ libgcc
WORKDIR /app
COPY --from=builder /work/chdash /app/chdash
COPY --from=static /work/src/static /app/static
COPY --from=wasm /work/src/static/wasm /app/static/wasm
COPY tests/entrypoints/source-entrypoint.sh /usr/local/bin/chdash-source-entrypoint
RUN chmod +x /usr/local/bin/chdash-source-entrypoint
EXPOSE 8080
HEALTHCHECK --interval=5s --timeout=1s --start-period=5s --retries=1 CMD ["/usr/local/bin/chdash-source-entrypoint", "--health"]
ENTRYPOINT ["/usr/local/bin/chdash-source-entrypoint"]
