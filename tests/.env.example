VISUAL_COMPARE=0

# Synthetic OTEL fixture (opt-in: docker compose --profile otel ...)
OTEL_FIXTURE_TRACES=10000
OTEL_FIXTURE_MIN_SPANS=60
OTEL_FIXTURE_MAX_SPANS=90
OTEL_FIXTURE_SEED=20260918
OTEL_FIXTURE_ERROR_RATE=0.0002
OTEL_FIXTURE_BATCH_TRACES=100
OTEL_FIXTURE_SPREAD_MINUTES=55
OTEL_FIXTURE_GENERATOR=auto
OTEL_FIXTURE_SQL_THRESHOLD=50000
OTEL_FIXTURE_SQL_CHUNK_TRACES=2000000
OTEL_FIXTURE_SQL_TARGET_SPANS_PER_CHUNK=10000000
