CLICKHOUSE_USER=test
CLICKHOUSE_PASSWORD=test
CLICKHOUSE_TCP_PORT=19000
CLICKHOUSE_HTTP_PORT=18123
SOURCE_PORT=18080
SOURCE_CMAKE_BUILD_TYPE=Release

# Single test container
PERF_RUNS=5
PERF_WARMUP=1
