# Ports exposed on the host
TEST_UI_PORT=18082
SOURCE_PORT=18080
RELEASE_PORT=18081
CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_TCP_PORT=19000

# Runner behavior
TEST_RUNNER_AUTO_TESTS=1
TEST_RUNNER_AUTO_BENCHMARK=0
TEST_RUNNER_LOG_INITIAL_BYTES=131072
TEST_RUNNER_LOG_CHUNK_BYTES=65536
TEST_RUNNER_MAX_RUNS=30
TEST_RUNNER_MAX_HISTORY=30
TEST_RUNNER_FORMAT_PAGE_SIZE=20
TEST_RUNNER_FORMAT_MAX_DIFF_ROWS=1800
TEST_RUNNER_JSON_GZIP_MIN_BYTES=4096
TEST_RUNNER_JSON_GZIP_LEVEL=3
TEST_RUNNER_SSE_HEARTBEAT_SECONDS=15
TEST_RUNNER_QUIET_ACCESS_LOGS=1
TEST_RUNNER_REPORT_COMPRESSION_LEVEL=3
FORMAT_RESULTS_FLUSH_EVERY=20

# Benchmark settings
BENCH_RUNS=5
BENCH_WARMUP=1
BENCH_BASELINE=source
BENCH_HOST_IDS=
# host_id=url. URL credentials may be used per host for remote instances.
BENCH_CLICKHOUSE_HTTP_TARGETS=local=http://clickhouse:8123
BENCH_CLICKHOUSE_HTTP_USER=test
BENCH_CLICKHOUSE_HTTP_PASSWORD=test
BENCH_CLICKHOUSE_HTTP_DATABASE=default
BENCH_CLICKHOUSE_HTTP_VERIFY_TLS=1
BENCH_CLICKHOUSE_HTTP_CHUNK_SIZE=65536
BENCH_TRACE_COMPRESSION_LEVEL=3
BENCH_DISABLE_DIRECT_HTTP=0
BENCH_STRICT_EVENT_COUNTS=0
BENCH_NO_STRICT=0

# Source build settings
SOURCE_CMAKE_BUILD_TYPE=Release
QUERY_DESCRIBE_MODE=auto
QUERY_FINAL_STATS_FROM_QUERY_LOG=0
QUERY_FINAL_STATS_FLUSH_LOGS=0
QUERY_SAMPLE_INTERVAL_MS=40
QUERY_RESULT_BATCH_ROWS=1000
QUERY_RESULT_BATCH_BYTES=262144
QUERY_SSE_BATCH_EVENTS=8
QUERY_SSE_BATCH_BYTES=262144
QUERY_SSE_QUEUE_MAX_BYTES=8388608
QUERY_DESCRIBE_CACHE_ENTRIES=256
QUERY_DESCRIBE_CACHE_TTL_MS=60000
QUERY_MAX_SQL_BYTES=4194304
QUERY_SESSION_MAX_COUNT=256
QUERY_SESSION_ABANDONED_TTL_MS=60000
QUERY_SESSION_TERMINAL_TTL_MS=30000
QUERY_SESSION_REAPER_INTERVAL_MS=5000
FORMAT_CACHE_MAX_ENTRIES=512
FORMAT_CACHE_MAX_BYTES=16777216
FORMAT_CACHE_TTL_MS=600000
CH_CLIENT_POOL_MAX_IDLE=8
