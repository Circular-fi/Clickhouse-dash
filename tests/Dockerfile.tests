FROM mcr.microsoft.com/playwright:v1.64.0-noble@sha256:06a9939e57531807f8d5fd76ce44b53165ffb7d7501d87ab10e285c20b1e971f

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    CI=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv python3-pip ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/chdash-tests

ENV PATH="/opt/chdash-tests/bin:${PATH}"
WORKDIR /tests

# Every Python package, the dependencies too, is pinned with its hashes (requirements.txt is generated from
# requirements.in, see its header) and every npm package by the lockfile: a changed upstream file fails the build.
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt

COPY frontend/package.json frontend/package-lock.json /work/frontend/
WORKDIR /work/frontend
RUN npm ci --no-audit --no-fund

WORKDIR /tests
COPY api /tests/api
COPY backend-functional /tests/backend-functional
COPY performance /tests/performance
COPY frontend /work/frontend
COPY test-suite /tests/test-suite

CMD ["python", "/tests/test-suite/run-all-tests.py"]
