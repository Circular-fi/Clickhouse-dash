CFG_STRING("observability.traces", "table", c.otel_defaults.traces.table, "otel_traces", "The traces table of the OpenTelemetry Collector.")
CFG_STRING("observability.traces", "trace_index_table", c.otel_defaults.traces.trace_index_table, "otel_traces_trace_id_ts", "The table that gives the time range of a trace. A direct link to a trace needs it.")
CFG_INT("observability.traces", "default_lookback_minutes", int, c.otel_defaults.traces.default_lookback_minutes, "60", 1, 43200, false, "minutes", "The window of a search when the page names none. It is at most max_lookback_minutes.")
CFG_INT("observability.traces", "max_lookback_minutes", int, c.otel_defaults.traces.max_lookback_minutes, "10080", 1, 525600, false, "minutes", "The longest window of a search.")
CFG_INT("observability.traces", "search_limit", size_t, c.otel_defaults.traces.search_limit, "100", 1, 1000, false, "traces", "Traces that one search returns, at most.")
CFG_INT("observability.traces", "max_spans_per_trace", size_t, c.otel_defaults.traces.max_spans_per_trace, "10000", 100, 100000, false, "spans", "Spans of one trace that the detail reads, at most.")
CFG_INT("observability.traces", "linked_from_margin_minutes", int, c.otel_defaults.traces.linked_from_margin_minutes, "60", 1, 1440, false, "minutes", "The window of a linked-from search is the window of the trace widened by this margin.")

// ---- observability.logs -------------------------------------------------------------------------------------------------
CFG_BOOL("observability.logs", "enabled", c.otel_defaults.logs.enabled, "false", "Show the Logs page.")
CFG_STRING("observability.logs", "database", c.otel_defaults.logs.database, "otel", "The database of the logs table.")
CFG_STRING("observability.logs", "table", c.otel_defaults.logs.table, "otel_logs", "The logs table of the OpenTelemetry Collector.")
CFG_INT("observability.logs", "max_lookback_minutes", int, c.otel_defaults.logs.max_lookback_minutes, "10080", 1, 525600, false, "minutes", "The longest window of a search.")
CFG_INT("observability.logs", "search_limit", size_t, c.otel_defaults.logs.search_limit, "200", 1, 10000, false, "records", "Records that one search returns, at most.")
CFG_ENUM("observability.logs", "body_search", c.otel_defaults.logs.body_search, "token", "token|substring|off", "How a search reads the text of a record: token (hasToken, uses the index), substring (a scan) or off (no text search).")
CFG_INT("observability.logs", "trace_logs_limit", size_t, c.otel_defaults.logs.trace_logs_limit, "1000", 1, 10000, false, "records", "Records of one trace that the trace page shows, at most.")
CFG_INT("observability.logs", "trace_margin_before_seconds", int, c.otel_defaults.logs.trace_margin_before_seconds, "5", 0, 3600, false, "seconds", "The logs of a trace are read from this long before its start.")
CFG_INT("observability.logs", "trace_margin_after_seconds", int, c.otel_defaults.logs.trace_margin_after_seconds, "30", 0, 3600, false, "seconds", "The logs of a trace are read up to this long after its end.")

// ---- observability.metrics ----------------------------------------------------------------------------------------------
CFG_BOOL("observability.metrics", "enabled", c.otel_defaults.metrics.enabled, "false", "Show the Metrics page.")
CFG_STRING("observability.metrics", "database", c.otel_defaults.metrics.database, "otel", "The database of the metric tables.")
CFG_STRING("observability.metrics", "table_prefix", c.otel_defaults.metrics.table_prefix, "otel_metrics", "The prefix of the metric tables: <prefix>_gauge, <prefix>_sum, <prefix>_histogram and the others.")

// ---- mcp ----------------------------------------------------------------------------------------------------------------
CFG_BOOL("mcp", "enabled", c.mcp.enabled, "false", "Serve the MCP endpoint, POST /mcp.")
CFG_STRING("mcp", "storage_file", c.mcp.storage_file, "", "The JSON file of the keys that are made on the MCP page.")
CFG_BOOL("mcp", "manage_from_ui", c.mcp.manage_from_ui, "true", "Deprecated: use keys.mode. false is the static mode, true the hybrid mode. It stops the start when keys.mode is also in the file.")
CFG_BOOL("mcp.usage", "enabled", c.mcp.usage.enabled, "false", "Count what each key does (requests, errors, clients, time, rows, bytes) and keep it. Off: nothing is counted, the routes of the usage answer 404 not_enabled, and the Keys table has no Used column.")
CFG_ENUM("mcp.usage", "storage", c.mcp.usage.storage, "files", "files", "Where the usage is kept. Only files exists for now: one file for each instance of ChDash, in the directory dir. A database will come later.")
CFG_STRING("mcp.usage", "dir", c.mcp.usage.dir, "", "The directory of the usage files. Required when the usage is on. It must exist, and ChDash must be able to create files in it. Several ChDash can share it: each one writes its own file (the name of its instance and .jsonl.zst) and reads the others, so the answers add up the instances.")
CFG_STRING("mcp.usage", "instance", c.mcp.usage.instance, "", "The name of this ChDash in the usage files: 1 to 64 characters of A-Z a-z 0-9 . _ -. Two instances that run at the same time must not share it. Empty: the host name of the machine (the start fails when it is not a valid name: set this key).")
CFG_INT("mcp.usage", "retention_days", int64_t, c.mcp.usage.retention_days, "90", 1, 365, false, "days", "How long the usage of a key is kept (also after the key is deleted). It is kept by the minute, 5 minutes and 15 minutes up to the day, then by 3 hours (from 7 days), by 12 hours (from 30 days) and by the day.")
CFG_BOOL("mcp.usage", "all_keys", c.mcp.usage.all_keys, "false", "Let a key read the usage of all the keys of all the instances (the tool mcp_analysis_all_usage, which the tools of the key must also name). Never the ClickHouse cost of another key.")
CFG_INT("mcp", "max_rows", int64_t, c.mcp.max_rows, "1000", 1, 1000000, false, "rows", "Rows that a call returns, at most. A key can lower it.")
CFG_INT("mcp", "max_result_bytes", int64_t, c.mcp.max_result_bytes, "1048576", 1024, 268435456, false, "bytes", "Bytes that a call returns, at most.")
CFG_INT("mcp", "query_timeout_seconds", int64_t, c.mcp.query_timeout_seconds, "30", 1, 3600, false, "seconds", "The time of one call. A key can lower it.")
CFG_INT("mcp", "max_sql_bytes", int64_t, c.mcp.max_sql_bytes, "65536", 256, 4194304, false, "bytes", "The largest SQL text of a call.")
CFG_INT("mcp", "max_memory_bytes", int64_t, c.mcp.max_memory_bytes, "1073741824", 16777216, 1099511627776, false, "bytes", "max_memory_usage of a call.")
CFG_INT("mcp", "max_rows_to_read", int64_t, c.mcp.max_rows_to_read, "0", 0, 1000000000000000, false, "rows", "max_rows_to_read of a call. 0 = no limit from ChDash.")
CFG_INT("mcp", "rate_limit_per_minute", int64_t, c.mcp.rate_limit_per_minute, "600", 0, 1000000, false, "calls", "Calls that one key may make in one minute. 0 = no limit.")

// ---- telemetry: the OTLP export of the spans and of the call log of MCP (docs/server-telemetry.md) -------------------------------
CFG_BOOL("telemetry", "enabled", c.telemetry.enabled, "false", "Send the SERVER span of each MCP request, a child span for each ClickHouse statement of the call, the call log, and the CLIENT span of each call to the PDP of the access block to an OTLP/HTTP receiver (JSON encoding). It needs otlp_endpoint.")
CFG_CUSTOM("telemetry", "otlp_endpoint", "text", "", "http://host[:port][/path]", "The base URL of the OTLP/HTTP receiver. The spans go to <base>/v1/traces and the call log to <base>/v1/logs. Only http: ChDash has no TLS client. It is required when enabled is true. Give only one of otlp_endpoint, otlp_endpoint_env and otlp_endpoint_file.")
CFG_CUSTOM("telemetry", "otlp_endpoint_env", "environment variable name", "", "letters, digits and _", "The variable that holds the value of otlp_endpoint. Give only one of otlp_endpoint, otlp_endpoint_env and otlp_endpoint_file.")
CFG_CUSTOM("telemetry", "otlp_endpoint_file", "file path", "", "", "The file that holds the value of otlp_endpoint, without its last line end. Give only one of otlp_endpoint, otlp_endpoint_env and otlp_endpoint_file.")
CFG_STRING("telemetry", "service_name", c.telemetry.service_name, "chdash", "The service.name of the resource of the spans and the log records: 1 to 255 bytes, no control character.")
CFG_CUSTOM("telemetry", "export_interval", "duration", "5s", "100ms to 1h", "The longest time that a span or a log record waits in the queue before it is sent. A full batch is sent at once.")
CFG_CUSTOM("telemetry", "export_timeout", "duration", "10s", "100ms to 5m", "The time of one export request. A batch that fails with a connection error, 429, 502, 503 or 504 is sent again two times at most, then dropped and counted.")
CFG_CUSTOM("telemetry", "connect_timeout", "duration", "2s", "100ms to 1m", "The time to open the connection to the receiver. It is at most export_timeout.")
CFG_INT("telemetry", "max_queue_size", int64_t, c.telemetry.max_queue_size, "2048", 1, 1000000, false, "items", "The spans that wait for the export, at most, and the log records too. A new item past the limit is dropped and counted in chdash_telemetry_dropped_total.")
CFG_INT("telemetry", "max_export_batch_size", int64_t, c.telemetry.max_export_batch_size, "512", 1, 100000, false, "items", "The items of one export request, at most. It is at most max_queue_size.")
CFG_BOOL("telemetry", "call_log", c.telemetry.call_log, "true", "Send the call log (mcp.call) as OTLP log records too. The JSON line of the log is always written.")

// ---- access: the access of humans, contract 11 (docs/access.md; config.cpp reads every key) ------------------------------------------
CFG_CUSTOM("access", "mode", "one of authzen|open", "", "", "Required: a file without the access block stops the start. authzen: each request of the pages and of the API needs a valid identity token, and the PDP decides each action. open: no check; the start writes a warning. Use open only for a server alone on a closed network. open takes no identity block and no pdp block.")
CFG_CUSTOM("access.identity", "header", "text", "X-Identity-Token", "an HTTP header name, not Cookie or Authorization", "The request header that carries the identity token. The token is never read from a cookie or from a query parameter.")
CFG_CUSTOM("access.identity", "issuer", "text", "", "1 to 1024 bytes, no control character", "Required with authzen: the value that the iss claim of a token must have.")
CFG_CUSTOM("access.identity", "audience", "text", "", "1 to 256 bytes of UTF-8, no control character", "Required with authzen: the name of this server. The aud claim of a token must contain it. It is also the id of the service resource that ChDash sends to the PDP, and the server of GET /.well-known/access-actions.")
CFG_CUSTOM("access.identity", "public_keys", "text", "", "PEM, 1 to 16 SubjectPublicKeyInfo blocks", "The public keys of the issuer: Ed25519 (EdDSA) or P-256 with an uncompressed point (ES256). A token signed by one of them is accepted. Give exactly one of public_keys, public_keys_env and public_keys_file.")
CFG_CUSTOM("access.identity", "public_keys_env", "environment variable name", "", "letters, digits and _", "The variable that holds the value of public_keys. Give exactly one of public_keys, public_keys_env and public_keys_file.")
CFG_CUSTOM("access.identity", "public_keys_file", "file path", "", "", "The file that holds the value of public_keys, without its last line end. Give exactly one of public_keys, public_keys_env and public_keys_file.")
CFG_CUSTOM("access.identity", "max_age", "duration", "5m", "1s to 24h", "The longest life of a token: exp - iat is at most this value. A token with a longer life gets 401.")
CFG_CUSTOM("access.pdp", "url", "text", "", "http://host[:port][/path]", "Required with authzen: the base URL of the AuthZEN PDP. ChDash sends POST <url>/access/v1/evaluation and <url>/access/v1/evaluations. Only http: ChDash has no TLS client, so the network between ChDash and the PDP must be private to them. Give exactly one of url, url_env and url_file.")
CFG_CUSTOM("access.pdp", "url_env", "environment variable name", "", "letters, digits and _", "The variable that holds the value of url. Give exactly one of url, url_env and url_file.")
CFG_CUSTOM("access.pdp", "url_file", "file path", "", "", "The file that holds the value of url, without its last line end. Give exactly one of url, url_env and url_file.")
CFG_CUSTOM("access.pdp", "token_env", "environment variable name", "", "letters, digits and _", "The variable that holds the token of this server at the PDP (Authorization: Bearer). It is a secret. Give exactly one of token_env and token_file.")
CFG_CUSTOM("access.pdp", "token_file", "file path", "", "", "The file that holds the token of this server at the PDP, without its last line end. It is a secret. Give exactly one of token_env and token_file.")
CFG_CUSTOM("access.pdp", "timeout", "duration", "500ms", "10ms to 1m", "The time of one request to the PDP. Without an answer in this time, the decision is false (fail closed).")
CFG_CUSTOM("access.pdp", "cache_ttl", "duration", "30s", "0s to 1h", "How long ChDash keeps an answer of the PDP for one subject, action and resource. 0s: no cache. A failure is never kept.")

// ---- mcp.keys and mcp.mcp_key: the keys of the configuration (config.cpp reads them) -----------------------------------------
CFG_CUSTOM("mcp.keys", "mode", "one of static|dynamic|hybrid", "hybrid", "", "Which keys apply. static: the mcp_key blocks only (the page makes no key and the key file is not read). dynamic: the keys of the page only (an mcp_key block stops the start). hybrid: the two.")
CFG_CUSTOM("mcp.mcp_key", "token_env", "environment variable name", "", "letters, digits and _", "The variable that holds the token of the key: mcp_ and 43 base64url characters. It is a secret. Give exactly one of token_env and token_file. The token is never written in the file.")
CFG_CUSTOM("mcp.mcp_key", "token_file", "file path", "", "", "The file that holds the token of the key, without its last line end: mcp_ and 43 base64url characters. It is a secret. Give exactly one of token_env and token_file. The token is never written in the file.")
CFG_CUSTOM("mcp.mcp_key", "subject", "text", "", "1 to 64 characters of A-Z a-z 0-9 . _ @ + -", "The name of the user for whom the key operates. The call log shows it.")
CFG_CUSTOM("mcp.mcp_key", "tools", "list of texts", "[]", "names of tools, or *", "The tools that the key can call. * is every read tool but the restricted tools. An empty list means no tool.")
CFG_CUSTOM("mcp.mcp_key", "expires", "text", "", "an RFC 3339 time", "The time when the key stops. After it, a request with the key gets 401. Empty: the key does not expire.")
CFG_CUSTOM("mcp.mcp_key.scope", "hosts", "list of texts", "", "one name of a host that has mcp_uri", "The host that the key reads. A key reads one host. Default: the host with mcp_uri, when the configuration has one only.")
CFG_CUSTOM("mcp.mcp_key.scope", "databases", "list of texts", "[]", "patterns of databases and tables, or *", "The data that the key reads. An empty list means no data.")
CFG_CUSTOM("mcp.mcp_key.limits", "max_rows", "integer", "", "1 to mcp.max_rows", "The rows that a call of the key returns, at most. Default: the value of mcp.max_rows.")
CFG_CUSTOM("mcp.mcp_key.limits", "timeout_seconds", "integer", "", "1 to mcp.query_timeout_seconds", "The time of one call of the key. Default: the value of mcp.query_timeout_seconds.")
CFG_CUSTOM("mcp.mcp_key.limits", "rate_limit_per_minute", "integer", "", "1 to mcp.rate_limit_per_minute", "The requests that the key can send in one minute. Default: the value of mcp.rate_limit_per_minute.")

// ---- mcp.key: the older form of mcp_key (deprecated: ChDash reads it for one release, with a warning) -------------------------
CFG_CUSTOM("mcp.key", "name", "text", "", "a-z, 0-9, - and _ (at most 32 bytes), no ui_ at the start", "The name of the key. It is required and each key has a different one.")
CFG_CUSTOM("mcp.key", "secret_env", "environment variable name", "", "letters, digits and _", "The variable that holds the token of the key: an mcp_ token, or the UUID version 4 of an older key. It is a secret. Give exactly one of secret_env and secret_file. The secret is never written in the file.")
CFG_CUSTOM("mcp.key", "secret_file", "file path", "", "", "The file that holds the token of the key, without its last line end: an mcp_ token, or the UUID version 4 of an older key. It is a secret. Give exactly one of secret_env and secret_file. The secret is never written in the file.")
CFG_CUSTOM("mcp.key", "hosts", "list of texts", "", "one name of a host that has mcp_uri", "The host that the key reads. It is required. A key reads one host: make one key for each host.")
CFG_CUSTOM("mcp.key", "tools", "list of texts", "[]", "names of tools, or *", "The tools that the key can call. An empty list means no tool.")
CFG_CUSTOM("mcp.key", "databases", "list of texts", "[]", "patterns of databases and tables, or *", "The data that the key reads. An empty list means no data.")
CFG_CUSTOM("mcp.key", "max_rows", "integer", "", "1 to mcp.max_rows", "The rows that a call of the key returns, at most. Default: the value of mcp.max_rows.")
CFG_CUSTOM("mcp.key", "timeout_seconds", "integer", "", "1 to mcp.query_timeout_seconds", "The time of one call of the key. Default: the value of mcp.query_timeout_seconds.")
