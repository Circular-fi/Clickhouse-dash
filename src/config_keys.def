// The table of the settings of the configuration file: the one place that says what a key is, what it may hold and what it does.
// src/config_schema.cpp includes this file; tools/gen_config_reference.py reads it and writes docs/configuration-reference.md
// (a test checks that the two agree). A value outside its bounds stops the start with an error that names the key.
//
//   CFG_INT(block, key, C++ type, field of AppConfig `c`, default, min, max, zero, unit, description)
//     zero = true: the value 0 is also valid, and the description says what it means (off, no limit, automatic).
//   CFG_BOOL(block, key, field, default, description)
//   CFG_STRING(block, key, field, default, description)        any text (a name, a path)
//   CFG_ENUM(block, key, field, default, choices, description) one word of the list "a|b|c"
// The default is the text that the configuration shows with no file; tests/native/config_test.cpp checks it against the one
// of AppConfig. A default of 0 for a key that has an automatic value is the value of the file (0 = automatic).
//   CFG_CUSTOM(block, key, type, default, range, description)  read by config.cpp (not by apply_block): listed for the reference
//
// A block is the path of its name in the file, "server" or "observability.traces". Write one row on one line: the tools read it
// line by line. A key that needs more than a type and bounds (a list, the address of the server, a header name, a block
// that holds blocks) is read by code in config.cpp and is listed here with CFG_CUSTOM, so that the reference has it. The
// blocks that can appear more than once (clickhouse.host, mcp.key, query_library) have their keys in the table too.
//
// A secret has no key of its own in the file. Its two forms are rows: <name>_env (the name of an environment variable) and
// <name>_file (the path of a file). Exactly one of the two applies (docs/configuration.md, "Secrets").

// ---- the keys that config.cpp reads ----------------------------------------------------------------------------------
CFG_CUSTOM("server", "listen_host", "text", "0.0.0.0", "", "The address that the server listens on.")
CFG_CUSTOM("server", "listen_port", "integer", "8080", "1 to 65535", "The port that the server listens on.")
CFG_CUSTOM("query", "describe_mode", "one of auto|always|never", "auto", "", "When a statement is described before it runs, to read the types that the native client cannot read.")
CFG_CUSTOM("observability", "service_allowlist", "list of texts", "[\"*\"]", "256 bytes each", "The services that the three signals show: a name, a prefix with *, a suffix with *, or a regular expression in re:.")
CFG_CUSTOM("observability.traces", "highlighted_attributes", "list of texts", "service.version, deployment.environment.name, deployment.environment, http.route, user.id", "32 keys of 1 to 256 bytes", "Attributes that the trace header shows as chips.")
CFG_CUSTOM("mcp", "auth_header", "text", "Authorization", "an HTTP header name", "The request header that carries the key. Authorization takes Bearer <key>.")
CFG_CUSTOM("mcp", "allowed_origins", "list of texts", "[]", "https://host[:port], at most 256 bytes each", "The origins of the pages that may call from a browser. A call with no Origin is always accepted.")

// ---- clickhouse.host: one block for each ClickHouse host (config.cpp reads it) -------------------------------------------
CFG_CUSTOM("clickhouse.host", "name", "text", "", "1 or more bytes, no control character; 1 to 256 bytes of UTF-8 when access.mode = \"authzen\"", "The id of the host. It is required and each host has a different one. The pages and the API name the host with it. In the authzen mode, it is also the id of the host resource for the PDP (docs/access.md).")
CFG_CUSTOM("clickhouse.host", "label", "text", "", "", "The name that the pages show. Default: the value of name.")
CFG_CUSTOM("clickhouse.host", "runner_uri", "text", "", "clickhouse://user@host[:port][?parameters]", "The URI of the account that runs the queries of the people (the runner). It is required. It never holds a password: use runner_password_env, runner_password_file, password_env or password_file. The parameters are compression, secure, verify, ca, ca_dir and sni.")
CFG_CUSTOM("clickhouse.host", "system_uri", "text", "", "clickhouse://user@host[:port][?parameters]", "The URI of the system account. The backend uses it for its own reads. It is required. It never holds a password: use system_password_env, system_password_file, password_env or password_file.")
CFG_CUSTOM("clickhouse.host", "mcp_uri", "text", "", "clickhouse://user@host[:port][?parameters]", "The URI of the account of the MCP tools. A host without it is not visible to MCP. It never holds a password: use mcp_password_env or mcp_password_file.")
CFG_CUSTOM("clickhouse.host", "password_env", "environment variable name", "", "letters, digits and _", "The variable that holds the password of runner_uri and of system_uri. It is a secret. Give only one of password_env and password_file, and none of the runner_password_* and system_password_* keys.")
CFG_CUSTOM("clickhouse.host", "password_file", "file path", "", "", "The file that holds the password of runner_uri and of system_uri, without its last line end. It is a secret. Give only one of password_env and password_file, and none of the runner_password_* and system_password_* keys.")
CFG_CUSTOM("clickhouse.host", "runner_password_env", "environment variable name", "", "letters, digits and _", "The variable that holds the password of runner_uri only. It is a secret. Give only one of runner_password_env and runner_password_file.")
CFG_CUSTOM("clickhouse.host", "runner_password_file", "file path", "", "", "The file that holds the password of runner_uri only, without its last line end. It is a secret. Give only one of runner_password_env and runner_password_file.")
CFG_CUSTOM("clickhouse.host", "system_password_env", "environment variable name", "", "letters, digits and _", "The variable that holds the password of system_uri only. It is a secret. Give only one of system_password_env and system_password_file.")
CFG_CUSTOM("clickhouse.host", "system_password_file", "file path", "", "", "The file that holds the password of system_uri only, without its last line end. It is a secret. Give only one of system_password_env and system_password_file.")
CFG_CUSTOM("clickhouse.host", "mcp_password_env", "environment variable name", "", "letters, digits and _", "The variable that holds the password of mcp_uri. It is a secret. It needs mcp_uri. Give only one of mcp_password_env and mcp_password_file. No other password key applies to mcp_uri.")
CFG_CUSTOM("clickhouse.host", "mcp_password_file", "file path", "", "", "The file that holds the password of mcp_uri, without its last line end. It is a secret. It needs mcp_uri. Give only one of mcp_password_env and mcp_password_file. No other password key applies to mcp_uri.")

// ---- clickhouse.host.observability: where the tables of one host are --------------------------------------------------------
CFG_CUSTOM("clickhouse.host.observability.traces", "enabled", "boolean", "", "", "Show the Traces page for this host. Default: the value of observability.traces.enabled.")
CFG_CUSTOM("clickhouse.host.observability.traces", "database", "text", "", "", "The database of the traces table of this host. Default: the value of observability.traces.database.")
CFG_CUSTOM("clickhouse.host.observability.traces", "table", "text", "", "", "The traces table of this host. Default: the value of observability.traces.table.")
CFG_CUSTOM("clickhouse.host.observability.traces", "trace_index_table", "text", "", "", "The table of this host that gives the time range of a trace. Default: the value of observability.traces.trace_index_table.")
CFG_CUSTOM("clickhouse.host.observability.logs", "enabled", "boolean", "", "", "Show the Logs page for this host. Default: the value of observability.logs.enabled.")
CFG_CUSTOM("clickhouse.host.observability.logs", "database", "text", "", "", "The database of the logs table of this host. Default: the value of observability.logs.database.")
CFG_CUSTOM("clickhouse.host.observability.logs", "table", "text", "", "", "The logs table of this host. Default: the value of observability.logs.table.")
CFG_CUSTOM("clickhouse.host.observability.metrics", "enabled", "boolean", "", "", "Show the Metrics page for this host. Default: the value of observability.metrics.enabled.")
CFG_CUSTOM("clickhouse.host.observability.metrics", "database", "text", "", "", "The database of the metric tables of this host. Default: the value of observability.metrics.database.")
CFG_CUSTOM("clickhouse.host.observability.metrics", "table_prefix", "text", "", "", "The prefix of the metric tables of this host. Default: the value of observability.metrics.table_prefix.")

// ---- server -------------------------------------------------------------------------------------------------------------
CFG_INT("server", "worker_threads", size_t, c.server.worker_threads, "0", 1, 1024, true, "threads", "Threads that stay ready to serve a request. 0 = the larger of 8 and the number of hardware threads.")
CFG_INT("server", "max_worker_threads", size_t, c.server.max_worker_threads, "256", 1, 4096, false, "threads", "The most threads that the pool grows to when streams hold threads. It is at least worker_threads.")
CFG_INT("server", "max_queued_requests", size_t, c.server.max_queued_requests, "1024", 16, 100000, false, "requests", "Requests that wait for a thread. A request past the limit is refused with 503.")
CFG_INT("server", "max_body_bytes", size_t, c.server.max_body_bytes, "0", 65536, 2147483648, true, "bytes", "The largest request body. A larger body is refused with 413 before it is read. 0 = derived from query.max_sql_bytes and the query library.")
CFG_INT("server", "max_host_streams", size_t, c.server.max_host_streams, "64", 0, 4096, false, "streams", "Open status streams of the pages (one for each visible page). It is at most half of max_worker_threads: a higher value stops the start. Past the limit a page polls.")
CFG_INT("server", "write_timeout_ms", int, c.server.write_timeout_ms, "120000", 1000, 3600000, false, "ms", "How long one write of a response waits for a client that does not read (a paused download). Past it the response ends.")
CFG_INT("server", "shutdown_timeout_ms", int, c.server.shutdown_timeout_ms, "10000", 1000, 600000, false, "ms", "How long a stop (SIGTERM, SIGINT) waits for the running requests. Past it the process ends with status 1.")
CFG_BOOL("server", "metrics", c.server.metrics, "true", "Serve GET /metrics (the Prometheus text format).")
CFG_BOOL("server", "access_log", c.server.access_log, "true", "Write one log line for each request. A probe that succeeds is not written.")
CFG_INT("server", "stats_log_interval_ms", int, c.server.stats_log_interval_ms, "300000", 10000, 86400000, true, "ms", "Write a server.stats log line this often. 0 = never.")

