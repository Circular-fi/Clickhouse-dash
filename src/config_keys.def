CFG_INT("query", "sse_batch_bytes", size_t, c.query_options.sse_write_batch_bytes, "262144", 16384, 4194304, false, "bytes", "Bytes that one write to the browser carries, at most.")
CFG_INT("query", "sse_queue_max_bytes", size_t, c.query_options.sse_queue_max_bytes, "8388608", 16384, 134217728, false, "bytes", "Bytes of results that wait for a slow browser. Past it ClickHouse waits. It is at least sse_batch_bytes.")
CFG_INT("query", "max_result_cell_bytes", size_t, c.query_options.max_result_cell_bytes, "33554432", 1024, 134217728, false, "bytes", "The largest value of one cell in a result. A larger value is cut.")
CFG_INT("query", "max_result_event_bytes", size_t, c.query_options.max_result_event_bytes, "33554432", 1024, 134217728, false, "bytes", "The largest result event.")
CFG_INT("query", "describe_cache_entries", size_t, c.query_options.describe_cache_entries, "256", 0, 4096, false, "entries", "Descriptions of statements that are kept. 0 = none.")
CFG_INT("query", "describe_cache_ttl_ms", int, c.query_options.describe_cache_ttl_ms, "60000", 0, 86400000, false, "ms", "How long a description is kept.")
CFG_INT("query", "session_max_count", size_t, c.query_session_max_count, "256", 1, 100000, false, "sessions", "Runs that exist at the same time. A run past the limit is refused with 429.")
CFG_INT("query", "session_abandoned_ttl_ms", int, c.query_session_abandoned_ttl_ms, "60000", 1000, 86400000, false, "ms", "A run whose stream the browser never opened ends after this time.")
CFG_INT("query", "session_terminal_ttl_ms", int, c.query_session_terminal_ttl_ms, "30000", 0, 86400000, false, "ms", "A finished run is kept for this time.")
CFG_INT("query", "session_reaper_interval_ms", int, c.query_session_reaper_interval_ms, "5000", 250, 60000, false, "ms", "How often ended runs are removed.")
CFG_INT("query", "cancel_token_ttl_ms", int, c.cancel_token_ttl_ms, "172800000", 1000, 172800000, false, "ms", "How long the token that cancels a run is valid.")
CFG_INT("query", "max_execution_time_s", int64_t, c.query_options.max_execution_time_s, "0", 0, 604800, false, "seconds", "max_execution_time of a run. 0 = the settings profile of the runner user decides. A bound is never looser than the profile.")
CFG_INT("query", "max_memory_usage", uint64_t, c.query_options.max_memory_usage, "0", 0, 1099511627776, false, "bytes", "max_memory_usage of a run. 0 = the settings profile of the runner user decides.")
CFG_INT("query", "max_rows_to_read", uint64_t, c.query_options.max_rows_to_read, "0", 0, 1000000000000000, false, "rows", "max_rows_to_read of a run. 0 = the settings profile of the runner user decides.")

